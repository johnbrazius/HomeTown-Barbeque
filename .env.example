# Copy to .env.local and fill in. Never commit real values.

# Canonical production origin, no trailing slash (used for canonical URLs,
# Open Graph, sitemap and structured data). On Vercel this falls back to the
# production deployment URL when unset.
NEXT_PUBLIC_SITE_URL=https://example.com

# Leave unset/false for the concept. Set to "true" ONLY for a launch the
# restaurant has approved — it allows search engines to index the site.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Optional analytics (Plausible, cookieless). Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
